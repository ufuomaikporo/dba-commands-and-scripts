<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Check User Permissions</Title>
      <Shortcut>chkper</Shortcut>
      <Description>Checks a users permissions for the database it is executed on. Script must be executed by user with IMPERSONATE permissions</Description>
      <Author>Ufuoma Ikporo</Author>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Username</ID>
          <ToolTip>Name of user whose permissions are being checked</ToolTip>
          <Default>EDDYFINDT\Vincent_Soo</Default>
        </Literal>
      </Declarations>
      <Code Language="SQL">
        <![CDATA[EXECUTE AS LOGIN = '$Username$'
SELECT SUSER_SNAME()
SELECT permission_name AS name , UPPER(entity_name) + '_PERMISSIONS' 
FROM fn_my_permissions(NULL, 'DATABASE')
UNION
SELECT name COLLATE Latin1_General_CI_AI, type_desc COLLATE Latin1_General_CI_AI
FROM [sys].[database_principals]
WHERE [type] in ('R','G') AND is_member(name) = 1
UNION
SELECT permission_name COLLATE Latin1_General_CI_AI   --p1.name UserName, 
	  ,class_desc + '_PERMISSIONS'
FROM sys.database_permissions pm
JOIN sys.database_principals p1 ON pm.grantee_principal_id = p1.principal_id
JOIN sys.database_principals p2 ON pm.grantor_principal_id = p2.principal_id
WHERE p1.name = USER
ORDER BY 2 DESC, 1

REVERT
GO
        ]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>