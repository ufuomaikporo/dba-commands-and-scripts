DECLARE @spatialIndexName varchar(100)
DECLARE @pkName varchar(100)

SET @spatialIndexName = (SELECT name FROM sys.spatial_indexes WHERE object_id = (select Object_id FROM sys.tables WHERE name = 'StationSeries'))
SET @pkName = (SELECT Constraint_Name FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE
						WHERE OBJECTPROPERTY(OBJECT_ID(CONSTRAINT_SCHEMA + '.' + QUOTENAME(CONSTRAINT_NAME)), 'IsPrimaryKey') = 1
						AND TABLE_NAME = 'StationSeries')

DECLARE @sql nvarchar(max)

SET @sql = 'DROP INDEX ' + @spatialIndexName + ' ON [dbo].[STATIONSERIES] '

EXEC sp_executesql @sql

SET @sql = 'ALTER TABLE [dbo].[STATIONSERIES] DROP CONSTRAINT ' + @pkName
EXEC sp_executesql @sql

SET @sql = 'ALTER TABLE [dbo].[STATIONSERIES] ADD  CONSTRAINT PK_STATIONSERIES PRIMARY KEY  (ID)

			CREATE SPATIAL INDEX [S_STATIONSERIES_idx] ON [dbo].[STATIONSERIES]
			(
				[Shape]
			)USING  GEOMETRY_AUTO_GRID 
			WITH (BOUNDING_BOX =(-400, -90, 400, 90), 
			CELLS_PER_OBJECT = 8, PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRIMARY]'
EXEC sp_executesql @sql








