
DECLARE @tableName varchar(100)
DECLARE @sql nvarchar(max)

DECLARE t_cursor CURSOR FOR
	SELECT Table_Name FROM INFORMATION_SCHEMA.Tables WHERE Table_Name IN ('INCIDENT','ANODE','VALVE','PROBE','INLINEINSPECTIONEVENT','PRESSURETEST','TANK','EQUIPMENT',
	'ATMOSPHERICINSPECTION','RISER','BIOPROBE','WELL','RECTIFIERENCLOSURE','GROUNDBED','PIPELINECHEMICALBATCH','CLEANINGTOOL','NODECONNECTION',
	'BOND','WELLCHEMICALBATCH','REPAIR','TESTPOINT','HIGHIMPACTLOCATION','WATERCROSSING','PIPELINECHEMICALINJECTION','CLEANINGTOOLRECEIVERLOC',
	'WELLCHEMICALINJECTION','COUPON','NODECONNECTIONFLOWDIRECTION')

OPEN t_cursor

	FETCH NEXT FROM t_cursor INTO @tableName

	WHILE @@FETCH_STATUS = 0
	BEGIN
		SET @sql = 'ALTER TABLE ' + @tableName + ' ADD SpatialOid INT'
		EXEC sp_executesql @sql
		
		IF @tableName <> 'NODECONNECTIONFLOWDIRECTION'
		BEGIN
			SET @sql = 'ALTER TABLE ' + @tableName + '  WITH CHECK ADD  CONSTRAINT [FK_' + @tableName + '_SpatialOid] FOREIGN KEY([SpatialOid]) REFERENCES ' + @tableName + 'POINT ([ObjectId])'
		END
		ELSE
		BEGIN
			SET @sql = 'ALTER TABLE ' + @tableName + '  WITH CHECK ADD  CONSTRAINT [FK_' + @tableName + '_SpatialOid] FOREIGN KEY([SpatialOid]) REFERENCES ' + @tableName + 'POLYLINE ([ObjectId])'
		END

		EXEC sp_executesql @sql

		FETCH NEXT FROM t_cursor INTO @tableName
	END

CLOSE t_cursor
DEALLOCATE t_cursor

DECLARE t2_cursor CURSOR FOR
	SELECT Table_Name FROM INFORMATION_SCHEMA.Tables WHERE Table_Name IN ('INCIDENTPOINT','ANODEPOINT','VALVEPOINT','PROBEPOINT','INLINEINSPECTIONEVENTPOINT','PRESSURETESTPOINT','TANKPOINT','EQUIPMENTPOINT',
	'NODECONNECTIONFLOWDIRECTIONPOLYLINE','ATMOSPHERICINSPECTIONPOINT','RISERPOINT','BIOPROBEPOINT','WELLPOINT','RECTIFIERENCLOSUREPOINT','GROUNDBEDPOINT',
	'PIPELINECHEMICALBATCHPOINT','CLEANINGTOOLPOINT','NODECONNECTIONPOINT','BONDPOINT','WELLCHEMICALBATCHPOINT','REPAIRPOINT','TESTPOINTPOINT','HIGHIMPACTLOCATIONPOINT',
	'WATERCROSSINGPOINT','PIPELINECHEMICALINJECTIONPOINT','CLEANINGTOOLRECEIVERLOCPOINT','WELLCHEMICALINJECTIONPOINT','COUPONPOINT')

OPEN t2_cursor

	FETCH NEXT FROM t2_cursor INTO @tableName

	WHILE @@FETCH_STATUS = 0
	BEGIN
		SET @sql = 'ALTER TABLE ' + @tableName + ' ADD RefId Numeric(10,0), DisplayName varchar(100)'
		EXEC sp_executesql @sql
		
		FETCH NEXT FROM t2_cursor INTO @tableName
	END

CLOSE t2_cursor
DEALLOCATE t2_cursor


