IF object_id('tu_CENTERPOLYLINE') IS NULL
BEGIN
	DECLARE @sql nvarchar(max)

	SET @sql = 'CREATE TRIGGER [dbo].[tu_CENTERPOLYLINE] ON [dbo].[CENTERPOLYLINE] FOR UPDATE AS 
				IF EXISTS(SELECT * FROM DELETED)
				BEGIN
					UPDATE dbo.CENTERPOLYLINE
					SET LastModByUserId = suser_sname(), LastModDateTime = getdate() 
					FROM dbo.CENTERPOLYLINE as t, DELETED as d
					WHERE t.OBJECTID=d.OBJECTID;
				END'

EXEC sp_executesql @sql
END
GO

