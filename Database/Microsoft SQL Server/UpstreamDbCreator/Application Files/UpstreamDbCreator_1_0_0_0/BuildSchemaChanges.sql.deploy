DECLARE @sql nvarchar(max)

IF EXISTS (SELECT * FROM INFORMATION_SCHEMA.Tables WHERE Table_Name = 'SchemaChanges')
BEGIN
	SET @sql = 'DROP TABLE SchemaChanges'
	EXEC sp_executesql @sql
END

SET @sql = 'SELECT ''IF object_id('''''' + tmp.FK_NAME + '''''') IS NOT NULL
BEGIN
	Alter table '' + tmp.TableName + '' Drop Constraint '' + tmp.FK_NAME + '';
END'' AS DropScript, 
''Alter Table '' + tmp.TableName + '' Add Constraint '' + tmp.FK_NAME + '' FOREIGN KEY ('' + tmp.ColumnName + '') REFERENCES StationSeries(ID);'' AS CreateScript
INTO SchemaChanges
FROM (
SELECT obj.name AS FK_NAME,tab1.name AS TableName, col1.name AS ColumnName,tab2.name AS ReferencedTable,col2.name AS ReferencedColumn
FROM sys.foreign_key_columns fkc
INNER JOIN sys.objects obj ON obj.object_id = fkc.constraint_object_id
INNER JOIN sys.tables tab1 ON tab1.object_id = fkc.parent_object_id
INNER JOIN sys.schemas sch ON tab1.schema_id = sch.schema_id
INNER JOIN sys.columns col1 ON col1.column_id = parent_column_id AND col1.object_id = tab1.object_id
INNER JOIN sys.tables tab2 ON tab2.object_id = fkc.referenced_object_id
INNER JOIN sys.columns col2 ON col2.column_id = referenced_column_id AND col2.object_id = tab2.object_id
) tmp
WHERE tmp.ReferencedTable = ''StationSeries'''
EXEC sp_executesql @sql




