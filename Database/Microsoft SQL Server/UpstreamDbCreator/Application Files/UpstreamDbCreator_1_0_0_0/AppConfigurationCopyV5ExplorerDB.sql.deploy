SET IDENTITY_INSERT dbo.AppConstraint ON
INSERT INTO dbo.AppConstraint
        ( ID,ConstraintName ,
          ConstraintRangeLow ,
          ConstraintRangeHigh ,
          ConstraintFormatMask ,
          ConstraintComments 
        )
SELECT  Id ,
        ConstraintName ,
        ConstraintRangeLow ,
        ConstraintRangeHigh ,
        ConstraintFormatMask ,
        ConstraintComments FROM <SourceServer>.<SourceDb>.dbo.AppConstraint

SET IDENTITY_INSERT dbo.AppConstraint OFF


