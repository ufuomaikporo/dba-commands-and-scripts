# Name: CopyFeatureClass.py
# Description: Copy the existing featureclass to the new one in the same environment.

# Import system modules
import arcpy
import getopt
import os
import sys
import time
import logging

def main(argv):
    HELP = 'CopyFeatureClass.py -p <platform> -s <server> -f <fromFeatureClass> -t <toFeatureClass> -d <database> -a <authentication> -u <username> -w <password> -v <version> -l <logFileName> -g <featureDataSet> -r <tmpFolder>'
    DEFAULT = '#'
    DATABASE = 'DATABASE_AUTH'
    OSA = 'OPERATING_SYSTEM_AUTH'

    platform = 'SQL_SERVER'
    server = ''
    database = ''
    authentication = OSA
    username = DEFAULT
    password = DEFAULT
    version = 'dbo.DEFAULT'
    fromFeatureClass = ''
    toFeatureClass = ''
    tmpFolder = r'C:\Temp'
    SDEFilename = r'SDEFile.sde'

    startTime = time.time()

    try:
        opts, args = getopt.getopt(argv, "hp:s:f:t:d:a:u:w:v:l:g:r:", ["platform=", "server=", "fromFeatureClass=", "toFeatureClass=", "database=", "authentication=", "username=", "password=", "version=", "logFileName=", "featureDataSet=", "tmpFolder="])
    except getopt.GetoptError:
        print(HELP)
        sys.exit(2)

    for opt, arg in opts:
        if opt == '-h':
            print(HELP)
            sys.exit()
        elif opt in ("-p", "--platform"):
            platform = arg
        elif opt in ("-s", "--server"):
            server = arg
        elif opt in ("-f", "--fromFeatureClass"):
            fromFeatureClass = arg
        elif opt in ("-t", "--toFeatureClass"):
            toFeatureClass = arg
        elif opt in ("-d", "--database"):
            database = arg
        elif opt in ("-a", "--authentication"):
            inputauth = arg
            if inputauth == 'database':
                authentication = DATABASE
        elif opt in ("-u", "--username"):
            inputuser = arg
            if inputuser != '':
                username = inputuser
        elif opt in ("-w", "--password"):
            inputpass = arg
            if inputpass != '':
                password = inputpass
        elif opt in ("-v", "--version"):
            inputversion = arg
            if inputversion != '':
                version = inputversion
        elif opt in ("-l", "--logFileName"):
            logFileName = arg
        elif opt in ("-g", "--featureDataSet"):
            featureDataSet = arg
        elif opt in ("-r", "--tmpFolder"):
            tmpFolder = arg
            
    FORMAT = '%(asctime)s - %(message)s'
    logging.basicConfig(filename=logFileName, level=logging.INFO, format=FORMAT)
    logging.info('Started to run ' + __file__)
    logging.info('Parameter "platform" = ' + platform)
    logging.info('Parameter "server" = ' + server)
    logging.info('Parameter "fromFeatureClass" = ' + fromFeatureClass)
    logging.info('Parameter "toFeatureClass" = ' + toFeatureClass)
    logging.info('Parameter "database" = ' + database)
    logging.info('Parameter "authentication" = ' + authentication)
    logging.info('Parameter "username" = ' + username)
    logging.info('Parameter "version" = ' + version)
    logging.info('Parameter "logFileName" = ' + logFileName)
    logging.info('Parameter "tmpFolder" = ' + tmpFolder)
    logging.info('Parameter "SDEFilename" = ' + SDEFilename)
    logging.info('Parameter "featureDataSet" = ' + featureDataSet)

    # if os.path.exists(tmpFolder + r"/" + SDEFilename):
    #     #delete the existing file
    #     os.remove(tmpFolder + r"/" + SDEFilename)

    # arcpy.management.CreateDatabaseConnection(tmpFolder, SDEFilename, platform, server, authentication, username, password, DEFAULT, database, DEFAULT, DEFAULT, version)

    arcpy.env.workspace = os.path.join(tmpFolder, SDEFilename)

    if len(featureDataSet) != 0:
        outputPath = os.path.join(tmpFolder, SDEFilename, featureDataSet)
    else:
        outputPath = os.path.join(tmpFolder, SDEFilename)

    #arcpy.Copy_management(os.path.join(tmpFolder, SDEFilename, fromFeatureClass), os.path.join(tmpFolder, SDEFilename, toFeatureClass))

    logging.info('Parameter "outputPath" = ' + outputPath)

    try:
        arcpy.conversion.FeatureClassToFeatureClass(fromFeatureClass, outputPath, toFeatureClass)
    except arcpy.ExecuteError:
        logging.info(arcpy.GetMessages(2))

    # print('SDE file is ', os.path.join(tmpFolder, SDEFilename))
    # print('Database Platform is ', platform)
    # print('Database Server is ', server)
    # print('Instance is ', database)
    # print('Authentication is ', authentication)
    # print('Username is ', username)
    # print('Password is ', password)
    # print('From FeatureClass is ', fromFeatureClass)
    # print('To FeatureClass is ', toFeatureClass)

    TimeElapes = time.time() - startTime
    
    logging.info('End to run ' + __file__ + ' with elapsed time of ' + str(TimeElapes) + 'seconds')

    # print("Time elapes: ", TimeElapes, " seconds")
if __name__ == "__main__":
    main(sys.argv[1:])    