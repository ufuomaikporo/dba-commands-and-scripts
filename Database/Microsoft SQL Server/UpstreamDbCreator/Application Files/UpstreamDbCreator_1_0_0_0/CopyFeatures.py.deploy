# Name: CopyFeatures.py
# Description: Copy the features from one featureclass to another

# Import system modules
import arcpy
import getopt
import os
import sys
import time
import logging

def main(argv):
    HELP = 'CopyFeatures.py -p <platform> -s <server> -f <fromFeatureClass> -t <toFeatureClass> -d <database> -a <authentication> -u <username> -w <password> -v <version> -i <InFields> -o <OutFields> -l <logFileName> -g <featureDataSet> -r <tmpFolder>'
    DEFAULT = '#'
    DATABASE = 'DATABASE_AUTH'
    OSA = 'OPERATING_SYSTEM_AUTH'

    platform = 'SQL_SERVER'
    server = ''
    database = ''
    authentication = OSA
    username = DEFAULT
    password = DEFAULT
    version = 'dbo.DEFAULT'
    fromFeatureClass = ''
    toFeatureClass = ''
    tmpFolder = r'C:\Temp'
    SDEFilename = r'SDEFile.sde'

    startTime = time.time()

    try:
        opts, args = getopt.getopt(argv, "hp:s:f:t:d:a:u:w:v:i:o:l:g:r:", ["platform=", "server=", "fromFeatureClass=", "toFeatureClass=", "database=", "authentication=", "username=", "password=", "version=", "InFields=", "OutFields", "logFileName=", "featureDataSet=", "tmpFolder="])
    except getopt.GetoptError:
        print(HELP)
        sys.exit(2)

    for opt, arg in opts:
        if opt == '-h':
            print(HELP)
            sys.exit()
        elif opt in ("-p", "--platform"):
            platform = arg
        elif opt in ("-s", "--server"):
            server = arg
        elif opt in ("-f", "--fromFeatureClass"):
            fromFeatureClass = arg
        elif opt in ("-t", "--toFeatureClass"):
            toFeatureClass = arg
        elif opt in ("-d", "--database"):
            database = arg
        elif opt in ("-a", "--authentication"):
            inputauth = arg
            if inputauth == 'database':
                authentication = DATABASE
        elif opt in ("-u", "--username"):
            inputuser = arg
            if inputuser != '':
                username = inputuser
        elif opt in ("-w", "--password"):
            inputpass = arg
            if inputpass != '':
                password = inputpass
        elif opt in ("-v", "--version"):
            inputversion = arg
            if inputversion != '':
                version = inputversion
        elif opt in ("-i", "--InFields"):
            InFields = arg
        elif opt in ("-o", "--OutFields"):
            OutFields = arg
        elif opt in ("-l", "--logFileName"):
            logFileName = arg
        elif opt in ("-g", "--featureDataSet"):
            featureDataSet = arg
        elif opt in ("-r", "--tmpFolder"):
            tmpFolder = arg
            
    FORMAT = '%(asctime)s - %(message)s'
    logging.basicConfig(filename=logFileName, level=logging.INFO, format=FORMAT)
    logging.info('Started to run ' + __file__)
    logging.info('Parameter "tmpFolder" = ' + tmpFolder)
    logging.info('Parameter "SDEFilename" = ' + SDEFilename)
    logging.info('Parameter "InFields" = ' + InFields)
    logging.info('Parameter "OutFields" = ' + OutFields)
    logging.info('Parameter "platform" = ' + platform)
    logging.info('Parameter "server" = ' + server)
    logging.info('Parameter "database" = ' + database)
    logging.info('Parameter "authentication" = ' + authentication)
    logging.info('Parameter "username" = ' + username)
    logging.info('Parameter "version" = ' + version)
    logging.info('Parameter "logFileName" = ' + logFileName)
    logging.info('Parameter "featureDataSet" = ' + featureDataSet)

    # if os.path.exists(tmpFolder + r"/" + SDEFilename):
    #     #delete the existing file
    #     os.remove(tmpFolder + r"/" + SDEFilename)

    # arcpy.management.CreateDatabaseConnection(tmpFolder, SDEFilename, platform, server, authentication, username, password, DEFAULT, database, DEFAULT, DEFAULT, version)

    if len(featureDataSet) != 0:
        arcpy.env.workspace = os.path.join(tmpFolder, SDEFilename, featureDataSet)
    else:
        arcpy.env.workspace = os.path.join(tmpFolder, SDEFilename)

    # InFields = ["Shape@", "LineName", "EffectiveEndDate"]
    # OutFields = ["Shape@", "LineName", "EffectiveEndDate"]

    InFields = InFields.split(",")
    OutFields = OutFields.split(",")

    with arcpy.da.SearchCursor(fromFeatureClass, InFields) as s_cursor:
        with arcpy.da.InsertCursor(toFeatureClass, OutFields) as i_cursor:
            for row in s_cursor:
                i_cursor.insertRow(row)

    # print("fromFeatureClass=", fromFeatureClass)
    # print("toFeatureClass=", toFeatureClass)

    # print("InFields=", InFields)
    # print("InFields=", OutFields)
    #arcpy.conversion.FeatureClassToFeatureClass(fromFeatureClass, os.path.join(tmpFolder, SDEFilename), toFeatureClass)

    TimeElapes = time.time() - startTime 
    logging.info('End to run ' + __file__ + ' with elapsed time of ' + str(TimeElapes) + 'seconds')
    
 #   print("Time elapes: ", TimeElapes, " seconds")
if __name__ == "__main__":
    main(sys.argv[1:])    